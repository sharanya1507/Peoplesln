<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="People_WinUI.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:People_WinUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <DataTemplate x:Key="PersonHeaderTemplate">
            <Grid Padding="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="50" />
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="80" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="PNo" FontWeight="Bold" />
                <TextBlock Grid.Column="1" Text="First Name" FontWeight="Bold" />
                <TextBlock Grid.Column="2" Text="Last Name" FontWeight="Bold" />
                <TextBlock Grid.Column="3" Text="Age" FontWeight="Bold" />
                <TextBlock Grid.Column="4" Text="SSLC" FontWeight="Bold" />
                <TextBlock Grid.Column="5" Text="PUC" FontWeight="Bold" />
                <TextBlock Grid.Column="6" Text="BE" FontWeight="Bold" />
                <TextBlock Grid.Column="7" Text="ME" FontWeight="Bold" />
                <TextBlock Grid.Column="8" Text="Hobby 1" FontWeight="Bold" />
                <TextBlock Grid.Column="9" Text="Hobby 2" FontWeight="Bold" />
                <TextBlock Grid.Column="10" Text="Hobby 3" FontWeight="Bold" />
                <TextBlock Grid.Column="11" Text="Total" FontWeight="Bold" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="PersonItemTemplate" x:DataType="local:PersonRow">
            <Grid Padding="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="50" />
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="80" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{x:Bind PNo}" />
                <TextBlock Grid.Column="1" Text="{x:Bind PFName}" />
                <TextBlock Grid.Column="2" Text="{x:Bind PSName}" />
                <TextBlock Grid.Column="3" Text="{x:Bind PAge}" />
                <TextBlock Grid.Column="4" Text="{x:Bind SslcMarks}" />
                <TextBlock Grid.Column="5" Text="{x:Bind PucMarks}" />
                <TextBlock Grid.Column="6" Text="{x:Bind BeMarksText}" />
                <TextBlock Grid.Column="7" Text="{x:Bind MeMarksText}" />
                <TextBlock Grid.Column="8" Text="{x:Bind Hobby1}" />
                <TextBlock Grid.Column="9" Text="{x:Bind Hobby2}" />
                <TextBlock Grid.Column="10" Text="{x:Bind Hobby3}" />
                <TextBlock Grid.Column="11" Text="{x:Bind TotalMarks}" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left side: form -->
        <ScrollViewer Grid.Column="0" Margin="0,0,20,0">
            <StackPanel Spacing="8">
                <TextBlock Text="Person Details" FontSize="20" FontWeight="Bold" Margin="0,0,0,8" />

                <TextBlock Text="Person No (auto)" />
                <TextBox x:Name="PNoBox" IsReadOnly="True" PlaceholderText="Assigned after Add" />

                <TextBlock Text="First Name" />
                <TextBox x:Name="FirstNameBox" />

                <TextBlock Text="Last Name" />
                <TextBox x:Name="LastNameBox" />

                <TextBlock Text="Age" />
                <TextBox x:Name="AgeBox" />

                <TextBlock Text="SSLC Marks" />
                <TextBox x:Name="SslcMarksBox" />

                <TextBlock Text="PUC Marks" />
                <TextBox x:Name="PucMarksBox" />

                <TextBlock Text="BE Marks (optional)" />
                <TextBox x:Name="BeMarksBox" />

                <TextBlock Text="ME Marks (optional)" />
                <TextBox x:Name="MeMarksBox" />

                <TextBlock Text="Hobby 1" />
                <TextBox x:Name="Hobby1Box" />

                <TextBlock Text="Hobby 2" />
                <TextBox x:Name="Hobby2Box" />

                <TextBlock Text="Hobby 3" />
                <TextBox x:Name="Hobby3Box" />

                <TextBlock Text="Total Marks" />
                <TextBox x:Name="TotalMarksBox" IsReadOnly="True" />

                <TextBlock x:Name="ValidationMessage"
                           Foreground="Red"
                           TextWrapping="Wrap"
                           Visibility="Collapsed" />

                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                    <Button x:Name="AddButton" Content="Add" Tag="Add" Click="ActionButton_Click" />
                    <Button x:Name="UpdateButton" Content="Update" Tag="Update" Click="ActionButton_Click" IsEnabled="False" />
                    <Button x:Name="DeleteButton" Content="Delete" Tag="Delete" Click="ActionButton_Click" IsEnabled="False" />
                    <Button x:Name="ClearButton" Content="Clear" Tag="Clear" Click="ActionButton_Click" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Right side: list of people and list of deleted people -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="2*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="1*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="All People" FontSize="20" FontWeight="Bold" Margin="0,0,0,8" />

            <ListView Grid.Row="1"
                      x:Name="PeopleListView"
                      HeaderTemplate="{StaticResource PersonHeaderTemplate}"
                      ItemTemplate="{StaticResource PersonItemTemplate}"
                      SelectionChanged="PeopleListView_SelectionChanged" />

            <TextBlock Grid.Row="2" Text="Deleted People" FontSize="20" FontWeight="Bold" Margin="0,12,0,8" />

            <ListView Grid.Row="3"
                      x:Name="DeletedPeopleListView"
                      HeaderTemplate="{StaticResource PersonHeaderTemplate}"
                      ItemTemplate="{StaticResource PersonItemTemplate}"
                      IsItemClickEnabled="False"
                      SelectionMode="None" />
        </Grid>
    </Grid>
</Page>
